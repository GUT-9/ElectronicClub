import { readFile, writeFile } from 'node:fs/promises'
import { forumSelect, FORUM_TABLES } from '../apps/functions/src/forum/query'
import {
  DEFAULT_FORUM_BOARDS,
  FORUM_PERMISSIONS,
  FORUM_PERMISSION_LABELS,
} from '../packages/shared/src/forum'
const base = await readFile('cloudbase/sql/008-stage3.sql', 'utf8')
const existing = base.match(
  /CREATE OR REPLACE FUNCTION electronicclub\.ec_table[\s\S]*?END \$\$;/,
)![0]
const whitelist = existing.replace(
  "'events','event_managers'",
  FORUM_TABLES.map((t) => `'${t}'`).join(',') + ",'events','event_managers'",
)
let sql = `-- Generated by npm run forum:sql:generate. Native PostgreSQL, no CREATE ROLE.\nBEGIN;\nSELECT pg_advisory_xact_lock(1991,1);\n`
for (const table of FORUM_TABLES) {
  sql += `CREATE TABLE IF NOT EXISTS electronicclub.${table}(id text PRIMARY KEY,data jsonb NOT NULL CHECK(jsonb_typeof(data)='object'),CONSTRAINT ${table}_identity CHECK((data->>'id'=id) IS TRUE));\n`
}
const column = (table: string, name: string, expression: string) => {
  sql += `ALTER TABLE electronicclub.${table} ADD COLUMN IF NOT EXISTS ${name} text GENERATED ALWAYS AS (${expression}) STORED;\n`
}
for (const table of ['forum_posts']) {
  column(table, 'board_id', "data->>'boardId'")
  column(table, 'author_uid', "data->>'authorUid'")
}
for (const table of ['forum_comments']) {
  column(table, 'post_id', "data->>'postId'")
  column(table, 'author_uid', "data->>'authorUid'")
  column(table, 'parent_id', "data->>'parentId'")
}
for (const table of ['forum_likes', 'forum_favorites']) {
  column(table, 'post_id', "data->>'postId'")
  column(table, 'member_uid', "data->>'uid'")
}
column('forum_images', 'post_id', "data->>'postId'")
column('forum_images', 'owner_uid', "data->>'ownerUid'")
column('forum_reports', 'post_id', "data->>'postId'")
column('forum_reports', 'reporter_uid', "data->>'reporterUid'")
column(
  'forum_reports',
  'comment_id',
  "CASE WHEN data->>'targetType'='comment' THEN data->>'targetId' END",
)
column('forum_notifications', 'post_id', "data->>'postId'")
column('forum_notifications', 'recipient_uid', "data->>'recipientUid'")
column('forum_notifications', 'comment_id', "data->>'commentId'")
column('forum_user_restrictions', 'member_uid', "data->>'uid'")
const constraint = (table: string, name: string, body: string) => {
  sql += `DO $$ BEGIN IF NOT EXISTS(SELECT 1 FROM pg_constraint WHERE conname='${name}' AND conrelid='electronicclub.${table}'::regclass) THEN ALTER TABLE electronicclub.${table} ADD CONSTRAINT ${name} ${body}; END IF; END $$;\n`
}
const fk = (t: string, c: string, parent: string, target = 'id') =>
  constraint(
    t,
    t + '_' + c + '_fk',
    `FOREIGN KEY(${c}) REFERENCES electronicclub.${parent}(${target})`,
  )
fk('forum_posts', 'board_id', 'forum_boards')
fk('forum_posts', 'author_uid', 'users')
constraint(
  'forum_comments',
  'forum_comments_id_post_unique',
  'UNIQUE(id,post_id)',
)
for (const t of [
  'forum_comments',
  'forum_likes',
  'forum_favorites',
  'forum_reports',
  'forum_notifications',
  'forum_images',
])
  fk(t, 'post_id', 'forum_posts')
for (const [t, c] of [
  ['forum_comments', 'author_uid'],
  ['forum_likes', 'member_uid'],
  ['forum_favorites', 'member_uid'],
  ['forum_reports', 'reporter_uid'],
  ['forum_notifications', 'recipient_uid'],
  ['forum_images', 'owner_uid'],
  ['forum_user_restrictions', 'member_uid'],
])
  fk(t!, c!, 'users')
constraint(
  'forum_comments',
  'forum_comments_parent_same_post',
  'FOREIGN KEY(parent_id,post_id) REFERENCES electronicclub.forum_comments(id,post_id)',
)
for (const t of ['forum_reports', 'forum_notifications'])
  constraint(
    t,
    t + '_comment_same_post',
    'FOREIGN KEY(comment_id,post_id) REFERENCES electronicclub.forum_comments(id,post_id)',
  )
for (const t of ['forum_likes', 'forum_favorites']) {
  constraint(t, t + '_member_unique', 'UNIQUE(post_id,member_uid)')
  constraint(
    t,
    t + '_key_valid',
    "CHECK((post_id IS NOT NULL AND member_uid IS NOT NULL AND id=post_id||':'||member_uid) IS TRUE)",
  )
}
constraint(
  'forum_user_restrictions',
  'forum_restriction_key',
  'CHECK((member_uid IS NOT NULL AND member_uid=id) IS TRUE)',
)
constraint(
  'forum_boards',
  'forum_board_valid',
  "CHECK((data->>'status' IN ('active','hidden','disabled') AND jsonb_typeof(data->'requireReview')='boolean' AND (data->>'position')::int BETWEEN 0 AND 1000) IS TRUE)",
)
constraint(
  'forum_images',
  'forum_image_state_valid',
  "CHECK((data->>'status'='staged' AND post_id IS NULL OR data->>'status'='attached' AND post_id IS NOT NULL) IS TRUE)",
)
constraint(
  'forum_notifications',
  'forum_notification_valid',
  "CHECK((recipient_uid IS NOT NULL AND post_id IS NOT NULL AND jsonb_typeof(data->'read')='boolean') IS TRUE)",
)
constraint(
  'forum_posts',
  'forum_post_valid',
  "CHECK((board_id IS NOT NULL AND author_uid IS NOT NULL AND data->>'status' IN ('pending','published','hidden','deleted') AND jsonb_array_length(data->'imageIds')<=3 AND (data->>'likeCount')::int>=0 AND (data->>'commentCount')::int>=0) IS TRUE)",
)
constraint(
  'forum_comments',
  'forum_comment_valid',
  "CHECK((post_id IS NOT NULL AND author_uid IS NOT NULL AND data->>'status' IN ('published','hidden','deleted') AND (data->>'floor')::int>0 AND parent_id IS DISTINCT FROM id) IS TRUE)",
)
constraint(
  'forum_images',
  'forum_image_valid',
  "CHECK((owner_uid IS NOT NULL AND (data->>'bytes')::int BETWEEN 20 AND 32768 AND length(data->>'dataUrl')<=45000 AND data->>'mime' IN ('image/jpeg','image/png','image/webp')) IS TRUE)",
)
constraint(
  'forum_reports',
  'forum_report_valid',
  "CHECK((post_id IS NOT NULL AND reporter_uid IS NOT NULL AND data->>'status' IN ('open','resolved','dismissed') AND (data->>'targetType'='comment' AND comment_id IS NOT NULL OR data->>'targetType'='post' AND data->>'targetId'=post_id)) IS TRUE)",
)
sql += `CREATE UNIQUE INDEX IF NOT EXISTS forum_comment_floor ON electronicclub.forum_comments(post_id,((data->>'floor')::int));\n`
for (const [t, expression] of [
  [
    'forum_posts',
    "board_id,(data->>'status'),((data->>'pinned')::boolean) DESC,(data->>'createdAt') DESC",
  ],
  [
    'forum_posts',
    "(data->>'status'),((data->>'featured')::boolean),(data->>'lastReplyAt') DESC",
  ],
  ['forum_posts', "author_uid,(data->>'createdAt') DESC"],
  ['forum_comments', "post_id,(data->>'status'),((data->>'floor')::int)"],
  ['forum_comments', "author_uid,(data->>'createdAt') DESC"],
  ['forum_notifications', "recipient_uid,(data->>'createdAt') DESC"],
  ['forum_reports', "(data->>'status'),(data->>'createdAt') DESC"],
  ['forum_favorites', 'member_uid,post_id'],
  ['forum_images', "owner_uid,(data->>'status'),(data->>'createdAt')"],
].entries()) {
  const [table, expr] = expression
  sql += `CREATE INDEX IF NOT EXISTS ${table}_list_${t} ON electronicclub.${table}(${expr});\n`
}
sql += whitelist + '\n'
sql += `CREATE OR REPLACE FUNCTION public.ec_forum_list(p_collection text,p_filter jsonb,p_offset integer,p_limit integer) RETURNS jsonb LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog AS $$\nDECLARE result jsonb;\nBEGIN\nPERFORM electronicclub.ec_assert_backend_role();\nIF jsonb_typeof(p_filter)<>'object' OR EXISTS(SELECT 1 FROM jsonb_object_keys(p_filter) k WHERE k NOT IN ('_createdBefore','_beforeFloor','status','boardId','postId','authorUid','recipientUid','reporterUid','ownerUid','uid','read','_search','_sort','_public','_favoriteUid','_featured','_notDeleted','_forumAudit')) OR EXISTS(SELECT 1 FROM jsonb_each(p_filter) kv WHERE jsonb_typeof(kv.value) NOT IN ('string','boolean')) THEN RAISE EXCEPTION 'INVALID_FORUM_FILTER'; END IF;\nIF p_filter ? '_beforeFloor' AND (p_filter->>'_beforeFloor' !~ '^[0-9]{1,9}$' OR p_collection<>'forum_comments') THEN RAISE EXCEPTION 'INVALID_FLOOR'; END IF;\nIF p_limit<1 OR p_limit>50 OR p_offset<0 THEN RAISE EXCEPTION 'INVALID_PAGE'; END IF;\nIF p_filter ? '_sort' AND p_filter->>'_sort' NOT IN ('latest','reply','hot','oldest','featured') THEN RAISE EXCEPTION 'INVALID_SORT'; END IF;\nCASE p_collection\n`
for (const table of [...FORUM_TABLES, 'audit_logs']) {
  sql += `WHEN '${table}' THEN\n`
  if (table === 'audit_logs')
    sql += `IF p_filter->>'_forumAudit' IS DISTINCT FROM 'true' THEN RAISE EXCEPTION 'INVALID_FORUM_AUDIT'; END IF;\n`
  sql += `EXECUTE '${forumSelect(table).replaceAll("'", "''")}' INTO result USING p_filter,p_limit,p_offset;\n`
}
sql += `ELSE RAISE EXCEPTION 'INVALID_FORUM_TABLE'; END CASE;\nRETURN result; END $$;\nREVOKE ALL ON FUNCTION public.ec_forum_list(text,jsonb,integer,integer) FROM PUBLIC,anon,authenticated;\nGRANT EXECUTE ON FUNCTION public.ec_forum_list(text,jsonb,integer,integer) TO service_role;\n`
for (const table of FORUM_TABLES)
  sql += `REVOKE ALL ON electronicclub.${table} FROM PUBLIC,anon,authenticated;\nGRANT SELECT,INSERT,UPDATE,DELETE ON electronicclub.${table} TO service_role;\n`
for (const board of DEFAULT_FORUM_BOARDS)
  sql += `INSERT INTO electronicclub.forum_boards(id,data) VALUES('${board.id}','${JSON.stringify(board).replaceAll("'", "''")}'::jsonb||jsonb_build_object('createdAt',now(),'updatedAt',now())) ON CONFLICT(id) DO NOTHING;\n`
for (const id of FORUM_PERMISSIONS)
  sql += `INSERT INTO electronicclub.permissions(id,data) VALUES('${id}','${JSON.stringify({ id, name: FORUM_PERMISSION_LABELS[id], group: '电子社区', implemented: true })}'::jsonb) ON CONFLICT(id) DO UPDATE SET data=excluded.data;\n`
sql += `INSERT INTO electronicclub.schema_migrations(version) VALUES('009-stage4-forum') ON CONFLICT DO NOTHING;\nNOTIFY pgrst,'reload schema';\nCOMMIT;\n`
const target = 'cloudbase/sql/009-stage4-forum.sql'
if (process.argv.includes('--check')) {
  if ((await readFile(target, 'utf8')) !== sql)
    throw new Error('Forum migration is stale; run npm run forum:sql:generate')
} else await writeFile(target, sql)
