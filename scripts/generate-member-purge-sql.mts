import { readFile, writeFile } from 'node:fs/promises'
import { MEMBER_BUSINESS_FIELDS } from '../apps/functions/src/members/purge'
const checks = Object.entries(MEMBER_BUSINESS_FIELDS)
  .map(
    ([table, fields]) =>
      `IF EXISTS(SELECT 1 FROM electronicclub.${table} WHERE ${fields.map((field) => `(data->>'${field}'=OLD.id OR data->'${field}' @> jsonb_build_array(OLD.id))`).join(' OR ')}) THEN RAISE EXCEPTION 'MEMBER_HAS_HISTORY' USING ERRCODE='P1401'; END IF;`,
  )
  .join('\n')
const sql = `-- Generated by npm run member-purge:sql:generate. Installs a capability only; deletes no accounts.
-- Requires 013 and predecessors. Existing roles, passwords and business records are unchanged.
BEGIN;
SELECT pg_advisory_xact_lock(1991,1);
DO $$ BEGIN IF NOT EXISTS(SELECT 1 FROM electronicclub.schema_migrations WHERE version='013-member-stats-resources') THEN RAISE EXCEPTION 'APPLY_013_FIRST'; END IF; END $$;
CREATE OR REPLACE FUNCTION electronicclub.ec_member_purge() RETURNS trigger
LANGUAGE plpgsql SECURITY INVOKER SET search_path=pg_catalog AS $$
DECLARE reference record; linked boolean;
BEGIN
 PERFORM pg_advisory_xact_lock(1991,1);
 IF OLD.data->>'status' IS DISTINCT FROM 'deleted' OR EXISTS(SELECT 1 FROM electronicclub.user_roles ur JOIN electronicclub.roles r ON r.id=ur.role_id WHERE ur.user_id=OLD.id AND r.data->>'super'='true') THEN
  RAISE EXCEPTION 'PURGE_NOT_ALLOWED' USING ERRCODE='P1402';
 END IF;
 IF EXISTS(SELECT 1 FROM electronicclub.privacy_jobs WHERE user_id=OLD.id AND data->>'status' IS DISTINCT FROM 'completed') THEN
  RAISE EXCEPTION 'PRIVACY_CLEANUP_PENDING' USING ERRCODE='P1403';
 END IF;
 ${checks}
 -- Future FK-backed business tables also block deletion, including CASCADE FKs.
 FOR reference IN
  SELECT c.conrelid::regclass AS relation,a.attname AS column_name
  FROM pg_constraint c JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum=ANY(c.conkey)
  WHERE c.contype='f' AND c.confrelid='electronicclub.users'::regclass
  AND c.conrelid NOT IN ('electronicclub.credentials'::regclass,'electronicclub.sessions'::regclass,'electronicclub.student_ids'::regclass,'electronicclub.privacy_jobs'::regclass,'electronicclub.user_roles'::regclass)
 LOOP
  EXECUTE format('SELECT EXISTS(SELECT 1 FROM %s WHERE %I::text=$1)',reference.relation,reference.column_name) INTO linked USING OLD.id;
  IF linked THEN RAISE EXCEPTION 'MEMBER_HAS_HISTORY' USING ERRCODE='P1401'; END IF;
 END LOOP;
 -- Remove import snapshots of this member, retaining batch progress and all other rows.
 UPDATE electronicclub.import_jobs j SET data=jsonb_set(j.data,'{rows}',
  (SELECT coalesce(jsonb_agg(CASE WHEN r.value->>'uid'=OLD.id OR (coalesce(OLD.data->>'studentId','')<>'' AND upper(r.value#>>'{member,studentId}')=upper(OLD.data->>'studentId'))
   THEN (r.value-'member'-'uid')||jsonb_build_object('error','个人资料已随成员彻底删除') ELSE r.value END ORDER BY r.ord),'[]'::jsonb)
   FROM jsonb_array_elements(j.data->'rows') WITH ORDINALITY AS r(value,ord)))
 WHERE EXISTS(SELECT 1 FROM jsonb_array_elements(j.data->'rows') r WHERE r->>'uid'=OLD.id OR (coalesce(OLD.data->>'studentId','')<>'' AND upper(r#>>'{member,studentId}')=upper(OLD.data->>'studentId')));
 UPDATE electronicclub.audit_logs SET data=data-'login'
 WHERE data ? 'login' AND (data#>>'{login,memberUid}'=OLD.id OR (data->>'action'='auth.login' AND data->>'actor'=OLD.id));
 DELETE FROM electronicclub.credentials WHERE id=OLD.id;
 DELETE FROM electronicclub.sessions WHERE user_id=OLD.id;
 DELETE FROM electronicclub.student_ids WHERE user_id=OLD.id;
 DELETE FROM electronicclub.privacy_jobs WHERE user_id=OLD.id;
 -- user_roles is removed by its original ON DELETE CASCADE; role counts are adjusted by the API transaction.
 RETURN OLD;
END $$;
REVOKE ALL ON FUNCTION electronicclub.ec_member_purge() FROM PUBLIC;
DO $$ DECLARE browser_role text;BEGIN FOR browser_role IN SELECT rolname FROM pg_roles WHERE rolname IN ('anon','authenticated') LOOP EXECUTE format('REVOKE ALL ON FUNCTION electronicclub.ec_member_purge() FROM %I',browser_role);END LOOP;END $$;
GRANT EXECUTE ON FUNCTION electronicclub.ec_member_purge() TO service_role;
DROP TRIGGER IF EXISTS member_purge ON electronicclub.users;
CREATE TRIGGER member_purge BEFORE DELETE ON electronicclub.users FOR EACH ROW EXECUTE FUNCTION electronicclub.ec_member_purge();
INSERT INTO electronicclub.permissions(id,data) VALUES('members.purge','{"id":"members.purge","name":"彻底删除成员（不可恢复）","group":"账号与安全","implemented":true}'::jsonb) ON CONFLICT(id) DO UPDATE SET data=excluded.data;
INSERT INTO electronicclub.system(id,data) VALUES('member_purge','{"version":"014-member-purge"}'::jsonb) ON CONFLICT(id) DO UPDATE SET data=excluded.data;
INSERT INTO electronicclub.schema_migrations(version) VALUES('014-member-purge') ON CONFLICT DO NOTHING;
NOTIFY pgrst,'reload schema';
COMMIT;
`
const file = 'cloudbase/sql/014-member-purge.sql'
if (process.argv.includes('--check')) {
  if ((await readFile(file, 'utf8')) !== sql)
    throw new Error('Member purge migration is stale')
} else await writeFile(file, sql)
