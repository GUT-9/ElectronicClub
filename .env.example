# 前端构建变量：复制到 apps/web/.env.local（不要填写密钥）
# 留空时开发环境使用 Vite /api 代理
VITE_API_BASE_URL=
# 云函数运行变量：在 CloudBase 控制台配置，精确填写前端站点 Origin
ALLOWED_ORIGIN=https://your-site.example.com
# 本地后端可选端口；修改后需同步 Vite 代理
PORT=3001

# CloudBase 云函数成员系统（服务端）
CLOUDBASE_ENV_ID=
# 生产必须省略 COOKIE_SECURE 或设为 true；仅本地HTTP允许false
COOKIE_SECURE=true
# 本地显式测试适配器可设 MEMBER_STORE=memory；生产不使用此变量
# MEMBER_STORE=memory
# 首次初始化私有CLI所需 BOOTSTRAP_STUDENT_ID / BOOTSTRAP_NAME / BOOTSTRAP_PASSWORD；可选 BOOTSTRAP_NICKNAME
# 和本地 LOCAL_ADMIN_STUDENT_ID / LOCAL_ADMIN_PASSWORD 请安全注入，不保存凭据

# PostgreSQL运行配置见 cloudbase/backend.env.example；PG模式不使用文档SDK
DATABASE_URL=
PG_CA_CERT=
PG_TLS=verify
# 默认服务端通过环境ID和云函数执行身份调用PostgreSQL HTTPS RPC；无需DATABASE_URL。
DB_DRIVER=cloudbase-http
# 可选服务端私有API Key；云函数默认使用平台临时身份，无需手工填写。禁止填写浏览器公开Key。
CLOUDBASE_APIKEY=
