{
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @electronic-club/web",
  "outputDirectory": "apps/web/dist",
  "nodeVersion": "22",
  "caches": [
    { "source": "/api", "cacheTtl": 0 },
    { "source": "/api/*", "cacheTtl": 0 }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/resources",
      "destination": "/index.html"
    },
    {
      "source": "/news",
      "destination": "/index.html"
    },
    {
      "source": "/news/*",
      "destination": "/index.html"
    },
    {
      "source": "/activities",
      "destination": "/index.html"
    },
    {
      "source": "/activities/*",
      "destination": "/index.html"
    },
    {
      "source": "/community",
      "destination": "/index.html"
    },
    {
      "source": "/community/*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/*",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/change-password",
      "destination": "/index.html"
    }
  ]
}
