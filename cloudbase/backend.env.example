# Default runtime: official CloudBase PostgreSQL HTTPS RPC endpoint; no TCP required.
DB_DRIVER=cloudbase-http
CLOUDBASE_ENV_ID=
# PRIVATE server key whose mapped PostgreSQL role has ec_* RPC permissions.
# Never a browser/anon key; never put this into Vite or publish screenshots.
CLOUDBASE_APIKEY=
ALLOWED_ORIGIN=https://eclub.gut9.cn
COOKIE_SECURE=true

# Optional existing native TCP adapter: set DB_DRIVER=postgres-tcp to use these.
# Endpoint/password and CA must come from the actual provider, not the environment ID.
DATABASE_URL=
PG_CA_CERT=
PG_TLS=verify

# Private bootstrap terminal ONLY. Never persist these in the public function.
BOOTSTRAP_STUDENT_ID=
BOOTSTRAP_NAME=
BOOTSTRAP_NICKNAME=
BOOTSTRAP_PASSWORD=
SQL_DIR=./sql
