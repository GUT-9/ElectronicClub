# Securely inject the provider-issued PostgreSQL URL; never commit actual credentials.
DATABASE_URL=
# PEM CA chain provided by your actual PostgreSQL endpoint operator
PG_CA_CERT=
PG_TLS=verify
ALLOWED_ORIGIN=
COOKIE_SECURE=true
# Only private bootstrap terminal, never persist password in public runtime configuration
BOOTSTRAP_STUDENT_ID=
BOOTSTRAP_NAME=
BOOTSTRAP_NICKNAME=
BOOTSTRAP_PASSWORD=
# private migration terminal relative directory
SQL_DIR=./sql
