# Default runtime: official CloudBase PostgreSQL HTTPS RPC endpoint; no TCP required.
DB_DRIVER=cloudbase-http
CLOUDBASE_ENV_ID=
# OPTIONAL: defaults to SCF execution identity through platform-injected TENCENTCLOUD_* temporary credentials.
# Do not manually persist root SecretId/SecretKey in the function.
# If explicitly using an API key, it must be a private restricted server key, never a browser/anon key.
CLOUDBASE_APIKEY=
ALLOWED_ORIGIN=https://eclub.gut9.cn
COOKIE_SECURE=true

# Optional existing native TCP adapter: set DB_DRIVER=postgres-tcp to use these.
# Endpoint/password and CA must come from the actual provider, not the environment ID.
DATABASE_URL=
PG_CA_CERT=
PG_TLS=verify

# Private bootstrap terminal ONLY. Never persist these in the public function.
BOOTSTRAP_STUDENT_ID=
BOOTSTRAP_NAME=
BOOTSTRAP_NICKNAME=
BOOTSTRAP_PASSWORD=
SQL_DIR=./sql
# Default lax. For limited cross-site testing only: none requires HTTPS origin + Secure.
# Modern browsers may still block third-party cookies. This does not permit production use of the default API domain.
COOKIE_SAMESITE=lax
# Optional forum image text budget (32MiB default; confirm actual database quota).
# FORUM_IMAGE_BUDGET_BYTES=33554432
# Optional login IP header fallback, disabled by default. Only set after confirming
# the gateway strips client-supplied values and writes the actual source address.
# Platform requestContext sourceIp always takes priority. See DEPLOY-LOGIN-HISTORY.md.
# LOGIN_TRUSTED_IP_HEADER=x-real-ip
