# Default runtime: official CloudBase PostgreSQL HTTPS RPC endpoint; no TCP required.
DB_DRIVER=cloudbase-http
CLOUDBASE_ENV_ID=
# OPTIONAL: defaults to SCF execution identity through platform-injected TENCENTCLOUD_* temporary credentials.
# Do not manually persist root SecretId/SecretKey in the function.
# If explicitly using an API key, it must be a private restricted server key, never a browser/anon key.
CLOUDBASE_APIKEY=
ALLOWED_ORIGIN=https://eclub.gut9.cn
COOKIE_SECURE=true
# 可选：与EdgeOne函数填写相同4位数字；旧64位hex值继续兼容。
# 4位值易被猜到，只用于便捷代理配置，不提供可靠IP防伪能力。
# 仅放服务端，不加VITE前缀；不是CloudBase Key。见docs/same-origin-api.md。
# ECLUB_PROXY_SECRET=

# Optional existing native TCP adapter: set DB_DRIVER=postgres-tcp to use these.
# Endpoint/password and CA must come from the actual provider, not the environment ID.
DATABASE_URL=
PG_CA_CERT=
PG_TLS=verify

# Private bootstrap terminal ONLY. Never persist these in the public function.
BOOTSTRAP_STUDENT_ID=
BOOTSTRAP_NAME=
BOOTSTRAP_NICKNAME=
BOOTSTRAP_PASSWORD=
SQL_DIR=./sql
# Default lax. For limited cross-site testing only: none requires HTTPS origin + Secure.
# Modern browsers may still block third-party cookies. This does not permit production use of the default API domain.
COOKIE_SAMESITE=lax
# Optional forum image text budget (32MiB default; confirm actual database quota).
# FORUM_IMAGE_BUDGET_BYTES=33554432
# Optional login IP header fallback, disabled by default. Only set after confirming
# the gateway strips client-supplied values and writes the actual source address.
# For this unsigned fallback, gateway context takes priority. Authenticated
# ECLUB_PROXY_SECRET metadata is separate; see DEPLOY-SAME-ORIGIN.md.
# LOGIN_TRUSTED_IP_HEADER=x-real-ip
# Qiniu public club-resource library. Backend ONLY; never VITE_* or Git credentials.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=edwell-k12
QINIU_DOWNLOAD_DOMAIN=https://oss.gut9.cn
# QINIU_UPLOAD_URL=https://upload.qiniup.com
# QINIU_RESOURCE_MAX_BYTES=52428800
# QINIU_RESOURCE_BUDGET_BYTES=134217728

# Generate public copy in /admin/public-site BEFORE enabling qiniu mode.
# Uses existing Qiniu credentials; no new paid service or browser keys.
# PUBLIC_SITE_MODE=qiniu
# Prefer the bucket HTTPS S3 origin to avoid stale CDN manifests.
# PUBLIC_SITE_ORIGIN=https://edwell-k12.s3.cn-east-1.qiniucs.com
# Optional VERIFIED shared PostgreSQL resource-points/core-second price.
# Leave unset if unknown; 150 core-seconds per window is NOT 150 points.
# PG_POINTS_PER_CORE_SECOND=
